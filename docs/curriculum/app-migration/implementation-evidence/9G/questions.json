    {
      "key": {
        "question_id": "situation-105",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-105",
      "category": "safety",
      "prompt": [
        {
          "type": "text",
          "text": "Heavy traffic makes a country-road left turn unsafe. What is a sensible alternative?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-105-option-1",
          "text": [
            {
              "type": "text",
              "text": "Continue to a suitable permitted place or route, change direction safely, and return for a right turn if allowed and safe."
            }
          ],
          "image": null
        },
        {
          "id": "situation-105-option-2",
          "text": [
            {
              "type": "text",
              "text": "Stop suddenly without signalling"
            }
          ],
          "image": null
        },
        {
          "id": "situation-105-option-3",
          "text": [
            {
              "type": "text",
              "text": "Force an oncoming driver to brake"
            }
          ],
          "image": null
        },
        {
          "id": "situation-105-option-4",
          "text": [
            {
              "type": "text",
              "text": "Reverse back along the main road"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-105-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "This is a conditional planning alternative, not permission for an immediate U-turn. Check signs, access, visibility and turning restrictions; if no suitable return exists, choose another route or postpone."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-105-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "A safe, permitted return route can avoid the hazardous left turn. If no suitable route exists, choose another route or postpone."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-105-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "Following drivers may not react in time."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-105-option-3",
            "explanation": [
              {
                "type": "text",
                "text": "You must not create that conflict."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-105-option-4",
            "explanation": [
              {
                "type": "text",
                "text": "That introduces a dangerous manoeuvre."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          }
        ]
      },
