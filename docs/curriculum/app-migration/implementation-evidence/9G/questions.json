    {
      "key": {
        "question_id": "situation-107",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-107",
      "category": "safety",
      "prompt": [
        {
          "type": "text",
          "text": "A car follows you too closely. How can you reduce the risk?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-107-option-1",
          "text": [
            {
              "type": "text",
              "text": "Gradually increase your gap ahead and avoid unnecessary sudden braking; brake as needed in an emergency."
            }
          ],
          "image": null
        },
        {
          "id": "situation-107-option-2",
          "text": [
            {
              "type": "text",
              "text": "Brake sharply to teach them a lesson"
            }
          ],
          "image": null
        },
        {
          "id": "situation-107-option-3",
          "text": [
            {
              "type": "text",
              "text": "Close your own following gap"
            }
          ],
          "image": null
        },
        {
          "id": "situation-107-option-4",
          "text": [
            {
              "type": "text",
              "text": "Speed beyond the limit"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-107-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "More space ahead can help you slow more gently. Do not brake to punish the following driver, but do not delay necessary emergency braking."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-107-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "Increase the gap gradually and avoid unnecessary abrupt braking; essential emergency braking still takes priority."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-107-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "That can trigger a rear-end collision."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-107-option-3",
            "explanation": [
              {
                "type": "text",
                "text": "That leaves less time for a smooth response."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-107-option-4",
            "explanation": [
              {
                "type": "text",
                "text": "That adds risk and does not solve the underlying problem."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          }
        ]
      },
