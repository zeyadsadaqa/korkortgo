    {
      "key": {
        "question_id": "situation-032",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-032",
      "category": "rules",
      "prompt": [
        {
          "type": "text",
          "text": "What do times in parentheses on a parking panel normally refer to?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-032-option-1",
          "text": [
            {
              "type": "text",
              "text": "Weekdays before Sundays and public holidays."
            }
          ],
          "image": null
        },
        {
          "id": "situation-032-option-2",
          "text": [
            {
              "type": "text",
              "text": "Only Sundays"
            }
          ],
          "image": null
        },
        {
          "id": "situation-032-option-3",
          "text": [
            {
              "type": "text",
              "text": "Every weekday"
            }
          ],
          "image": null
        },
        {
          "id": "situation-032-option-4",
          "text": [
            {
              "type": "text",
              "text": "Only school holidays"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-032-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "Parenthesised times apply on weekdays before Sundays and public holidays. Sundays and public holidays use the red times; a named day can override the usual category."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-032-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "Parentheses mean weekdays before Sundays and public holidays, including relevant holiday eves; they do not include a Sunday merely because it precedes a holiday."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-032-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "Sundays and public holidays normally use red times."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-032-option-3",
            "explanation": [
              {
                "type": "text",
                "text": "Ordinary weekday times are shown without parentheses."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-032-option-4",
            "explanation": [
              {
                "type": "text",
                "text": "School holidays do not define these times."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          }
        ]
      },
