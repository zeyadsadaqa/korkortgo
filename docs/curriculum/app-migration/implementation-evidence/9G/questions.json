    {
      "key": {
        "question_id": "situation-162",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-162",
      "category": "vehicle",
      "prompt": [
        {
          "type": "text",
          "text": "In Swedish vehicle terminology, how is a car’s registered total weight (totalvikt) defined?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-162-option-1",
          "text": [
            {
              "type": "text",
              "text": "Ready-for-service weight (tjänstevikt), already including the driver, plus maximum passenger and goods load."
            }
          ],
          "image": null
        },
        {
          "id": "situation-162-option-2",
          "text": [
            {
              "type": "text",
              "text": "Only the current luggage weight"
            }
          ],
          "image": null
        },
        {
          "id": "situation-162-option-3",
          "text": [
            {
              "type": "text",
              "text": "The weight shown by a scale today in every case"
            }
          ],
          "image": null
        },
        {
          "id": "situation-162-option-4",
          "text": [
            {
              "type": "text",
              "text": "The maximum speed multiplied by fuel capacity"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-162-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "Totalvikt combines the car’s defined ready-for-service weight and maximum passenger/goods load. The driver is included in tjänstevikt; actual current gross weight is a different quantity."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-162-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "Use the Swedish defined ready-for-service weight, which already includes the driver, plus the maximum passenger and goods load."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-162-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "That is only part of a load."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
