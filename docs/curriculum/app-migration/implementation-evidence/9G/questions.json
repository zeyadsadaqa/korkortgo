    {
      "key": {
        "question_id": "situation-125",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-125",
      "category": "safety",
      "prompt": [
        {
          "type": "text",
          "text": "You accidentally strike an unattended parked car. What should you do?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-125-option-1",
          "text": [
            {
              "type": "text",
              "text": "Notify the owner or police as soon as possible and provide your details."
            }
          ],
          "image": null
        },
        {
          "id": "situation-125-option-2",
          "text": [
            {
              "type": "text",
              "text": "Drive away if damage seems small"
            }
          ],
          "image": null
        },
        {
          "id": "situation-125-option-3",
          "text": [
            {
              "type": "text",
              "text": "Wait until next month to mention it"
            }
          ],
          "image": null
        },
        {
          "id": "situation-125-option-4",
          "text": [
            {
              "type": "text",
              "text": "Only photograph your own car"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-125-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "After damaging unattended property, notify the affected person or police as soon as possible. Do not leave without dealing with the incident."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-125-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "Notify the owner or police promptly; looking for the owner must not become a reason to postpone notification."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-125-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "Damage can be hidden and duties remain."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-125-option-3",
            "explanation": [
              {
                "type": "text",
                "text": "The response should not be postponed."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-125-option-4",
            "explanation": [
              {
                "type": "text",
                "text": "That does not inform the affected owner."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          }
        ]
      },
