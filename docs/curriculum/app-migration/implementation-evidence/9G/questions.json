    {
      "key": {
        "question_id": "situation-045",
        "revision": "scenario-r2"
      },
      "concept_id": "situation-045",
      "category": "rules",
      "prompt": [
        {
          "type": "text",
          "text": "When driving an ordinary passenger car on the road, may you use dipped headlights and front fog lights together?"
        }
      ],
      "image": null,
      "options": [
        {
          "id": "situation-045-option-1",
          "text": [
            {
              "type": "text",
              "text": "No."
            }
          ],
          "image": null
        },
        {
          "id": "situation-045-option-2",
          "text": [
            {
              "type": "text",
              "text": "Yes in all darkness"
            }
          ],
          "image": null
        },
        {
          "id": "situation-045-option-3",
          "text": [
            {
              "type": "text",
              "text": "Yes if your car is new"
            }
          ],
          "image": null
        },
        {
          "id": "situation-045-option-4",
          "text": [
            {
              "type": "text",
              "text": "Yes when overtaking"
            }
          ],
          "image": null
        }
      ],
      "feedback": {
        "target_sign_code": null,
        "english_label": null,
        "correct_option_id": "situation-045-option-1",
        "explanation": [
          {
            "type": "text",
            "text": "For this car, use the permitted lighting for visibility; dipped headlights and front fog lights must not be used together. The separate daylight-motorcycle exception is outside this scenario."
          }
        ],
        "option_feedback": [
          {
            "option_id": "situation-045-option-1",
            "explanation": [
              {
                "type": "text",
                "text": "For the passenger car specified here, the combination is prohibited. Do not generalise this answer to the separate daylight-motorcycle exception."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-045-option-2",
            "explanation": [
              {
                "type": "text",
                "text": "Darkness does not permit that combination."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-045-option-3",
            "explanation": [
              {
                "type": "text",
                "text": "Vehicle age does not change the rule."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          },
          {
            "option_id": "situation-045-option-4",
            "explanation": [
              {
                "type": "text",
                "text": "Overtaking creates no lighting exception."
              }
            ],
            "sign_code": null,
            "english_label": null,
            "source_uses": []
          }
        ]
      },
