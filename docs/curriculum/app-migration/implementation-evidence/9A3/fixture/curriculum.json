          "payload": {
            "role": "explanation",
            "text": [
              {
                "text": "Reading a road means combining instructions, movement, visibility and uncertainty. A sign tells you something important; it rarely tells you everything needed for the next decision.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        }
