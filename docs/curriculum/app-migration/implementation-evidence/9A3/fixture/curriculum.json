            "related_content": [],
            "source_uses": [
              {
                "editorial_inference": false,
                "locator": "Retained approved M03 passage and its source evidence.",
                "reference_id": "REF-9f4b74a976fa03fb",
                "scope_id": "M03",
                "source_id": "source-traffic-law"
              }
            ]
          },
          "payload": {
            "role": "requirement",
            "text": [
              {
                "text": "Follow the traffic instructions that apply to you. Where an instruction differs from a general traffic rule, the instruction governs. A steady traffic-light indication takes precedence over a yield or stop sign; a police officer's direction takes precedence over the rules and ordinary traffic instructions. This is not a rule that a green signal cancels every other restriction. Authorised guards also give traffic directions that must be followed.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        },
