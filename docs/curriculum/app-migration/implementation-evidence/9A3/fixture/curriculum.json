        {
          "metadata": {
            "id": "M03-L02/fixture-requirement",
            "origin": {
              "evidence_ids": [],
              "file": {
                "path": "docs/curriculum/app-design/8d/content-bindings-v1.json",
                "sha256": "d1dbe15c97b839f17710968c3583c22be0afb442b0c7e06296fb2240a8a2a8e0"
              },
              "locator": "json:/requirements_opening",
